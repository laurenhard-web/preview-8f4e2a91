  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "UUID v4 key for safe 24h idempotent retries on POST mutations (Stripe standard).",
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "RSIVersion": {
        "name": "RSI-Version",
        "in": "header",
        "required": false,
        "description": "Date-based API version pin (default: 2026-11-05).",
        "schema": {
          "type": "string",
          "default": "2026-11-05"
        }
      }
    },
    "schemas": {
      "DomainSphere": {
        "type": "object",
        "required": [
          "sphere_id",
          "title",
          "category",
          "primary_sources",
          "core_rules"
        ],
        "properties": {
          "sphere_id": {
            "type": "string",
            "example": "iconic_design_aesthetics_ferrari_pininfarina"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "aesthetic_canon",
              "engineering_domain",
              "legal_domain",
              "culinary_domain",
              "interactive_simulation"
            ]
          },
          "primary_sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "core_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "db_schema_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DonorBlueprint": {
        "type": "object",
        "required": [
          "donor_id",
          "sphere_id",
          "title",
          "origin_url",
          "sha256_hash"
        ],
        "properties": {
          "donor_id": {
            "type": "string",
            "example": "dnr_ferrari_pininfarina_centro_stile"
          },
          "sphere_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "origin_url": {
            "type": "string",
            "format": "uri"
          },
          "quality_score": {
            "type": "number",
            "example": 99.4
          },
          "architecture_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sha256_hash": {
            "type": "string"
          }
        }
      },
      "FeatureFlag": {
        "type": "object",
        "required": [
          "flag_key",
          "enabled",
          "dept",
          "epoch_introduced"
        ],
        "properties": {
          "flag_key": {
            "type": "string",
            "example": "flg_ferrari_centro_stile_canon"
          },
          "enabled": {
            "type": "boolean"
          },
          "dept": {
            "type": "string"
          },
          "epoch_introduced": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "SelfEvolutionEpoch": {
        "type": "object",
        "required": [
          "epoch_num",
          "operator",
          "department",
          "public_score",
          "private_score"
        ],
        "properties": {
          "epoch_num": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "node_id": {
            "type": "string",
            "example": "node_self_ep20_champion"
          },
          "operator": {
            "type": "string",
            "enum": [
              "DRAFT",
              "IMPROVE",
              "DEBUG",
              "FUSE",
              "PRUNE"
            ]
          },
          "department": {
            "type": "string"
          },
          "lead_agent": {
            "type": "string"
          },
          "focus_area": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "public_score": {
            "type": "number"
          },
          "private_score": {
            "type": "number"
          },
          "generalization_gap": {
            "type": "number"
          },
          "bloat_penalty": {
            "type": "number"
          },
          "verdict": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/rsi/spheres": {
      "get": {
        "operationId": "listKnowledgeSpheres",
        "summary": "List all extensible Domain Knowledge Spheres & Aesthetic Canons",
        "responses": {
          "200": {
            "description": "List of spheres from domain_spheres_catalog"
          }
        }
      },
      "post": {
        "operationId": "delegateNewSphereCreation",
        "summary": "Chief Architect Delegation: commission subagents to create a new Knowledge Sphere",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "Delegation order created in architect_delegation_orders"
          }
        }
      }
    },
    "/api/rsi/donors": {
      "get": {
        "operationId": "listDonorVaultBlueprints",
        "summary": "List downloaded Donor Blueprints from storage/donors_vault/ with SHA-256 verification",
        "responses": {
          "200": {
            "description": "List of 12+ canonical donors"
          }
        }
      },
      "post": {
        "operationId": "harvestLiveDonorFromUrl",
        "summary": "Harvest and index a new donor website/spec into storage/donors_vault/",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "Donor blueprint saved and indexed in FTS5"
          }
        }
      }
    },
    "/api/rsi/flags": {
      "get": {
        "operationId": "listFeatureFlagsAndConfig",
        "summary": "Get all 18 typed Feature Flags, config.toml state, and Linear sync_op_log count",
        "responses": {
          "200": {
            "description": "Feature flags and diagnostics"
          }
        }
      },
      "post": {
        "operationId": "toggleFeatureFlag",
        "summary": "Toggle a Feature Flag with Linear-style sync_op_log audit & Stripe Idempotency-Key",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated flag state and monotonic seq_id"
          }
        }
      }
    },
    "/api/rsi/self-evolution-epochs": {
      "get": {
        "operationId": "list20SelfEvolutionEpochs",
        "summary": "Return the 20-Epoch Teamwork Self-Evolution trajectory (Epoch #0 -> #20 Champion)",
        "responses": {
          "200": {
            "description": "20 epochs with Public/Private SpecGuard scores and causal hypotheses"
          }
        }
      }
    },
    "/api/rsi/openapi.json": {
      "get": {
        "operationId": "getOpenAPI31Specification",
        "summary": "Download live auto-introspected OpenAPI 3.1.0 JSON contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1.0 JSON document"
          }
        }
      }
    },
    "/api/cockpit/overview": {
      "get": {
        "operationId": "getCockpitOverview",
        "summary": "Unified Hive Mind + RSI-0 v9 cockpit snapshot (agents, trees, debates, verdicts, spheres, donors, flags)",
        "responses": {
          "200": {
            "description": "Full cockpit payload"
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "operationId": "listHiveMindAgents",
        "summary": "List 8 specialist agents across 5 Hive Mind departments with ratings and quota stats",
        "responses": {
          "200": {
            "description": "Agents leaderboard"
          }
        }
      }
    },
    "/api/memory": {
      "get": {
        "operationId": "queryHybridKagFts5Memory",
        "summary": "Hybrid BM25 FTS5 + 2-hop KAG Knowledge Graph memory recall",
        "responses": {
          "200": {
            "description": "Episodes, directives, and KAG subgraph"
          }
        }
      }
    }
  }
}